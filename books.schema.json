{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "series_name": { "type": "string" },
          "series_order": { "type": "number" },
          "series_total": { "type": ["number", "string"] },
          "author": { "type": "string" },
          "pages": { "type": "integer" },
          "rating": { "type": "number" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "cover": { "type": "string", "format": "uri" },
          "description": { "type": "string" },
          "notes": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "links": {
            "anyOf": [
              {
                "type": "array",
                "items": { "type": "string" }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "title",
          "series_order",
          "series_total",
          "author",
          "pages",
          "rating",
          "start_date",
          "end_date",
          "cover",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["books"],
  "additionalProperties": false
}
